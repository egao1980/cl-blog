;;;; brutal: the blog's rules on top of engels. Bands of one flat colour,
;;;; uppercase headings that invert on hover. Colours are the --blog-*
;;;; custom properties (src/theme.lisp), so light and dark both work.

(* :margin 0)

;; The brutal theme's type scale (engels' Marx scale is one step larger).
(h1 :font-size 32px)
(h2 :font-size 28px)
(h3 :font-size 24px)
(h4 :font-size 20px)
(h5 :font-size 18px)
(h6 :font-size 16px)

((:or header footer)
 :padding 0
 :border none)

((body > header)
 :display grid
 :grid-template-columns auto 1fr
 :align-items start
 :justify-content center)

((body > header > *)
 :height 100%
 :background "var(--blog-band)"
 :display grid
 :font-stretch extra-expanded
 :letter-spacing 0.5em
 :align-items center
 :text-align end)

((body > footer)
 :display grid
 :grid-template-columns auto
 :align-items center
 :justify-content center
 :padding 1em
 :background "var(--blog-band)")

(a :display inline-block)

;; sanitize.css 13 resets nav lists inside :where() (no specificity), so
;; engels' ul padding wins over it; the old site (sanitize 11) had none.
((nav ul)
 :padding 0
 :margin 0)

((nav a)
 :width 100%
 :text-transform uppercase)

(((body > header) (:and a :link))
 :text-decoration none)

((:or h1 h2 h3 h4 h5)
 :margin 0
 :padding 10px 0
 :color "var(--blog-ink)"
 :background "var(--blog-band)"
 :text-transform uppercase)

(((:or h1 h2 h3 h4 h5) a)
 :margin 0
 :color "var(--blog-ink)"
 :background "var(--blog-band)")

((:and (:or h1 h2 h3 h4 h5 a) :hover)
 :color "var(--blog-paper)"
 :background "var(--blog-ink)")

(((:and (:or h1 h2 h3 h4 h5) :hover) a)
 :color "var(--blog-paper)"
 :background "var(--blog-ink)")

((:and a :link)
 :text-decoration underline
 :text-decoration-style dotted)

((:and a :hover)
 :text-decoration none)

(aside
 :padding 1em
 :background "var(--blog-band)")

((main > article)
 :margin-bottom 2em)

((article img)
 :max-width 100%
 :height auto)

;; Code keeps its lines: engels (Marx) wraps pre and breaks code anywhere,
;; which splits Lisp symbols. Blocks scroll instead.
(pre
 :white-space pre
 :overflow-x auto)

(code
 :background "var(--engels-code-bg)"
 :word-break normal
 :overflow-wrap anywhere)

((pre code)
 :overflow-wrap normal)

;; A docs page's contents (article > nav): plain links, nested lists
;; indented, unlike the uppercase full-width header and footer navs.
(((article > nav) a)
 :width auto
 :text-transform none)

(((article > nav) ul ul)
 :padding-left 1.5em)

(:media "(max-width: 600px)"
 ((body > header)
  :grid-template-columns 1fr)
 ((body > header > *)
  :text-align start)
 ;; a long title word (ALTERNATIVES) fits a phone; breaks as a last resort
 (((body > header) h1)
  :font-size 24px
  :letter-spacing 0.3em
  :overflow-wrap anywhere)
 ;; wide tables scroll instead of widening the page
 (table
  :display block
  :overflow-x auto))
